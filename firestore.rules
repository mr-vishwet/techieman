// TechieMan — Firestore security rules (M5).
// Publish in the Firebase console: Firestore Database → Rules → paste → Publish.
// Principle: a user can read/write ONLY their own docs. League member docs
// are readable by any signed-in player (leaderboards need that) but a player
// can write ONLY their own member doc (their weekly XP). Nothing is
// publicly writable; nothing requires admin SDK calls from the app.
//
// Data model (see src/firebase/sync.ts + leagues.ts):
//   users/{uid}                                   profile + weeklyXp
//   users/{uid}/progress/{nodeId}                 per-node state
//   users/{uid}/fights/{fightId}                 capped log (last 100)
//   leagues/{weekId}/groups/{id}/members/{uid}    weekly XP per member

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // A signed-in user owns their whole subtree. Anonymous users count —
    // request.auth is set for anonymous sign-in too.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /progress/{nodeId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /fights/{fightId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Leagues: any signed-in player can READ a league (they need the
    // leaderboard), but only write their OWN member doc — and only the
    // weeklyXp / displayName / updatedAt fields.
    match /leagues/{weekId}/groups/{groupId}/members/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['weeklyXp', 'displayName', 'updatedAt']);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // League group docs themselves are written by the weekly assignment
    // Cloud Function (or an admin), never by the app.
    match /leagues/{weekId}/groups/{groupId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
